rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: config
// Document ID: {docId} (specifically 'access' and 'stats')
// Fields for 'config/access':
//   - freeSets / paidSets / unlockedSets / accessMap: list or map (optional) - exam set access configuration
//   - vipEmails: list of strings (optional, max 1000 items) - VIP user email list
//   - updatedAt: timestamp or number (optional) - last update timestamp
// Fields for 'config/stats':
//   - totalVisits / visits / onlineUsers / activeUsers: number (optional, >= 0) - site counters
//   - updatedAt / lastUpdated: timestamp or number (optional) - last counter update
//
// Collection: users
// Document ID: {userId} (matches Firebase Auth UID)
// Fields:
//   - uid: string (optional/immutable) - Firebase Auth UID
//   - email: string (optional, max 256 chars) - user email address (PII)
//   - displayName: string (optional, max 256 chars) - user display name
//   - photoURL: string (optional, max 2048 chars) - profile image URL
//   - role: string (optional, max 50 chars) - user role ('user', 'vip', 'admin')
//   - isVip: bool (optional) - whether user has VIP access
//   - loginCount: number (optional, >= 0) - number of logins
//   - lastActiveAt / lastLoginAt / createdAt: timestamp, number, or string (optional)
//
// Collection: attempts
// Document ID: {attemptId}
// Fields:
//   - id: string (optional, max 128 chars) - attempt identifier
//   - uid: string (required, immutable, max 128 chars) - owner Firebase Auth UID
//   - userEmail / displayName: string (optional, max 256 chars) - user metadata
//   - examId: string (optional, max 100 chars) - exam identifier
//   - editionId: string (optional, max 100 chars) - exam edition identifier
//   - setId: string (optional, max 100 chars) - question set identifier
//   - mode: string (optional, 'real' | 'practice') - exam mode
//   - answers: list (optional, max 500 items) - selected choice indices
//   - flags: list (optional, max 500 items) - flagged question indices
//   - startedAt / endAt / submittedAt / createdAt: number or timestamp (optional)
//   - summary: map (optional) - score summary { score, label, color }
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is owner based on document's uid field
    function isDocOwner() {
      return isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Check if the user is the bootstrapped admin or has role == 'admin' in users/{uid}
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kunlanat.pakine@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin')
      );
    }

    // Validate optional string (if present and non-null, must be string within length bounds)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        request.resource.data[field] == null ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidConfigStats(data) {
      return data is map &&
        data.keys().size() <= 30;
    }

    function isValidConfigAccess(data) {
      return data is map &&
        data.keys().size() <= 50;
    }

    function isValidUser(data) {
      return data is map &&
        data.keys().size() <= 30 &&
        isValidOptionalString('uid', 1, 128) &&
        isValidOptionalString('email', 0, 256) &&
        isValidOptionalString('displayName', 0, 256) &&
        isValidOptionalString('name', 0, 256) &&
        isValidOptionalString('photoURL', 0, 2048) &&
        isValidOptionalString('role', 1, 50) &&
        (!('loginCount' in data) || (data.loginCount is number && data.loginCount >= 0));
    }

    function isValidAttempt(data) {
      return data is map &&
        data.keys().size() <= 30 &&
        ('uid' in data) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        isValidOptionalString('id', 1, 128) &&
        isValidOptionalString('examId', 1, 100) &&
        isValidOptionalString('editionId', 1, 100) &&
        isValidOptionalString('setId', 1, 100) &&
        isValidOptionalString('mode', 1, 30) &&
        isValidOptionalString('userEmail', 0, 256) &&
        isValidOptionalString('userName', 0, 256) &&
        isValidOptionalString('displayName', 0, 256) &&
        (!('answers' in data) || (data.answers is list && data.answers.size() <= 500)) &&
        (!('flags' in data) || (data.flags is list && data.flags.size() <= 500));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // 1. config/{docId} (specifically config/access and config/stats)
    match /config/{docId} {
      // Anyone can read config documents to check free vs paid sets, total stats, and VIP list
      allow read: if true;

      // config/stats can be created/updated by anyone to increment visit/online counters;
      // config/access (and other config docs) can only be written by an admin
      allow create, update: if (docId == 'stats' && isValidConfigStats(request.resource.data)) ||
        (isAdmin() && isValidConfigAccess(request.resource.data));

      allow delete: if isAdmin();
    }

    // 2. users/{userId}
    match /users/{userId} {
      // Users can read their own profile; admins can read all user profiles
      allow read: if isOwner(userId) || isAdmin();

      // Users can create their own profile as long as they don't set role to 'admin'
      // (unless they are an admin / kunlanat.pakine@gmail.com)
      allow create: if isAuthenticated() &&
        isValidUser(request.resource.data) &&
        (
          (isOwner(userId) && uidUnchanged() && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) ||
          isAdmin()
        );

      // Users can update their own profile as long as they don't escalate role to 'admin'
      // (unless they are an admin / kunlanat.pakine@gmail.com)
      allow update: if isAuthenticated() &&
        isValidUser(request.resource.data) &&
        (
          (isOwner(userId) && uidNotModified() && (!('role' in request.resource.data) || request.resource.data.role != 'admin')) ||
          isAdmin()
        );

      allow delete: if isAdmin();
    }

    // 3. attempts/{attemptId}
    match /attempts/{attemptId} {
      // Users can read their own exam attempts; admins can read all attempts
      allow read: if isDocOwner() || isAdmin();

      // Users can create their own exam attempts; admins can create attempts
      allow create: if isAuthenticated() &&
        isValidAttempt(request.resource.data) &&
        (request.resource.data.uid == request.auth.uid || isAdmin());

      // Users can update their own exam attempts without changing ownership; admins can update all
      allow update: if isAuthenticated() &&
        isValidAttempt(request.resource.data) &&
        ((isDocOwner() && request.resource.data.uid == request.auth.uid) || isAdmin());

      // Users can delete their own exam attempts; admins can delete any attempt
      allow delete: if isDocOwner() || isAdmin();
    }

    // Default deny for all other collections and paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
